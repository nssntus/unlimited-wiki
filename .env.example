# For transparent proxy/TUN setups that map public domains into 198.18.0.0/15.
WEB_ALLOW_FAKE_IP=0

# Leave WIKI_PUBLIC_ORIGIN empty for local development. LAN deployments must use
# one canonical HTTPS origin and explicitly trust only the local reverse proxy.
WIKI_PUBLIC_ORIGIN=
WIKI_TRUSTED_PROXY_CIDRS=
WIKI_REGISTRATION_MODE=open
WIKI_MAX_CONCURRENT_REQUESTS=64
WIKI_REQUEST_TIMEOUT_SECONDS=30
WIKI_MIN_FREE_BYTES=536870912

# Used by deploy/offline-backup.sh on the deployment host.
WIKI_PROJECT_ROOT=/opt/unlimited-wiki
WIKI_BACKUP_ROOT=/var/backups/unlimited-wiki
WIKI_SERVICE_USER=unlimited-wiki
