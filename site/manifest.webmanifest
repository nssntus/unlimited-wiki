{
  "name": "Unlimited Wiki",
  "short_name": "Unlimited Wiki",
  "description": "Local-first Markdown knowledge, private by default and shared through review.",
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
